<Window x:Class="wolle.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:wolle"
                      mc:Ignorable="d"
                      Title="" 
                      Width="350" 
                      SizeToContent="Height"
                      MaxHeight="400"
                      WindowStyle="None" 
                      ResizeMode="NoResize"
                      Background="Transparent"
                      AllowsTransparency="True"
                      Topmost="True"
                      WindowStartupLocation="CenterScreen"
                      ThemeMode="System">
    
    <Window.Resources>
        <!-- Shared button style for title bar buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                         UseAeroCaptionButtons="False"
                         NonClientFrameEdges="None"
                         ResizeBorderThickness="4"
                         CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Grid.Clip>
                    <RectangleGeometry RadiusX="8" RadiusY="8">
                        <RectangleGeometry.Rect>
                            <Rect X="0" Y="0" Width="350" Height="40"/>
                        </RectangleGeometry.Rect>
                    </RectangleGeometry>
                </Grid.Clip>
                
                <TextBlock Grid.Column="0" 
                           Text="Wolle" 
                           Margin="12,8,8,8" 
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                
                <Button Grid.Column="1" 
                        Content="⚙️" 
                        Click="SettingsButton_Click" 
                        Background="Transparent"
                        BorderThickness="0"
                        Width="32" 
                        Height="32"
                        Margin="0,0,0,0"
                        Padding="0"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Cursor="Hand"
                        Style="{StaticResource TitleBarButtonStyle}"/>
                
                <Button Grid.Column="2" 
                        Content="✕" 
                        Click="CloseButton_Click" 
                        Background="Transparent"
                        BorderThickness="0"
                        Width="32" 
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Cursor="Hand"
                        Style="{StaticResource TitleBarButtonStyle}"/>
            </Grid>
            
            <!-- Content Area -->
            <Border Grid.Row="1" Margin="8,8,8,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" ClipToBounds="True">
                <Grid Margin="12,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                
                <!-- Progress Section -->
                <StackPanel x:Name="ProgressSection" Grid.Row="0">
                    <!-- Indeterminate Progress Bar -->
                    <ProgressBar x:Name="ProgressRing" 
                                     Minimum="0" 
                                     Maximum="100" 
                                     Value="50"
                                     IsIndeterminate="True"
                                     Visibility="Visible"
                                     Height="20"
                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                     Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                     BorderThickness="0"/>
                        
                    <!-- Determinate Progress Bar -->
                    <ProgressBar x:Name="ProgressBar" 
                                   Minimum="0" 
                                   Maximum="100" 
                                   Value="0"
                                   Visibility="Collapsed"
                                   Height="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                   BorderThickness="0"/>
                    
                    <!-- Progress Details -->
                    <TextBlock x:Name="ProgressDetails" 
                               Text="This may take a few minutes on first run..." 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                
                <!-- Response Area -->
                <FlowDocumentScrollViewer x:Name="ResponseScrollViewer" 
                            Grid.Row="1"
                            MaxHeight="300"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Zoom="100"/>
                
                <!-- Error Area -->
                <TextBlock x:Name="ErrorTextBlock" 
                           Grid.Row="2"
                           TextWrapping="Wrap" 
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Visibility="Collapsed"/>
                
                <!-- Information Message Area -->
                <Border x:Name="InfoMessageBorder" 
                        Grid.Row="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,8,0,0"
                        Padding="16,12"
                        CornerRadius="8"
                        Effect="{DynamicResource CardShadow}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="InfoMessageTextBlock" 
                               TextWrapping="Wrap" 
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Border>
                
                <!-- Settings Area -->
                <StackPanel x:Name="SettingsPanel" 
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Settings" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="API Timeout (seconds):" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        
                        <TextBox x:Name="ApiTimeoutTextBox" 
                                 Grid.Column="1"
                                 Text="600"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Context Window Size:" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        
                        <ComboBox x:Name="ContextWindowSizeComboBox" 
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="32K" Tag="32000"/>
                            <ComboBoxItem Content="64K" Tag="64000"/>
                            <ComboBoxItem Content="128K" Tag="128000"/>
                        </ComboBox>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,16,0">
                        <Button Style="{DynamicResource AccentButtonStyle}" Content="Save" 
                                Click="SaveSettingsButton_Click" 
                                Margin="0,0,8,0" />
                        
                        <Button Content="Cancel" 
                                Click="CancelSettingsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>
        </Grid>
    </Border>
</Window>